<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<!-- Paste the Google Search Console meta tag here, e.g.:
<meta name="google-site-verification" content="YOUR_CODE" /> -->
<title>Mobique</title>
<style>
  :root{color-scheme:light dark;--fg:#1e293b;--muted:#64748b;--bg:#fff;--line:#e2e8f0;--accent:#4f46e5}
  @media(prefers-color-scheme:dark){:root{--fg:#e2e8f0;--muted:#94a3b8;--bg:#0f172a;--line:#334155;--accent:#93c5fd}}
  body{font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif;line-height:1.65;max-width:640px;margin:0 auto;padding:64px 20px;color:var(--fg);background:var(--bg)}
  h1{font-size:2.2rem;margin:0 0 4px}
  .lead{color:var(--muted);margin:0 0 32px}
  dl{display:grid;grid-template-columns:max-content 1fr;gap:4px 16px;margin:0;padding-top:24px;border-top:1px solid var(--line)}
  dt{color:var(--muted)}dd{margin:0}
  a{color:var(--accent)}
  footer{margin-top:48px;color:var(--muted);font-size:.85rem}
</style>
</head>
<body>
  <h1>Mobique</h1>
  <p class="lead">Mobile app and software development.</p>
  <dl>
    <dt>Company</dt><dd>Mobique Przemysław Nowotniak</dd>
    <dt>Tax ID (NIP)</dt><dd>1182320483</dd>
    <dt>Address</dt><dd> Loteryjki 69F/12, 01-937 Warsaw Poland</dd>
    <dt>Email</dt><dd><a href="mailto:mobique.studio@gmail.com">FILL_IN@example.com</a></dd>
  </dl>
  <footer>© 2026 Mobique</footer>
</body>
</html>
